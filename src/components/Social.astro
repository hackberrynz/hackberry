---
import { Icon } from "astro-icon/components";

const { icon, handle, href, subtitle } = Astro.props;

// only use `a` if href is not empty, otherwise just use a div
// the handle isn't selectable if it is a link, which is bad for things like email
const Tag = href ? "a" : "div";
---

<Tag
	class="card card-side bg-base-300 hover:bg-base-200 w-full social-link"
	data-encoded={btoa(href)}
	data-encoded-attr="href"
	href="loading"
>
	<figure class="pl-[24px]">
		<Icon name={icon} class="size-10 text-primary" />
	</figure>
	<div class="card-body">
		<h3
			class="card-title text-xl md:text-2xl social-handle"
			data-encoded={btoa(handle)}
		>
			<span class="invisible">loading</span>
		</h3>
		<p class="text-lg">{subtitle}</p>
	</div>
</Tag>
