---
const { heading, subheading } = Astro.props;

import { event } from "../data/data.ts";
---

<header>
	<div class="overflow-clip py-40 md:py-45">
		<div
			class:list={[
				"-rotate-3",
				"scale-110",
				"bg-primary/80",
				// band padding = slim, but always fits its content
				"py-6 md:py-8",
				"flex justify-center items-center",
			]}
		>
			<div class:list={["w-full px-4", "flex justify-center items-center"]}>
				<div
					class="flex flex-col items-center gap-2 md:gap-3 text-center text-shadow-lg"
				>
					<h1
						class="text-[12vw] lg:text-8xl text-accent font-mono leading-none"
					>
						{heading}
					</h1>
					<h2 class="text-[4.5vw] lg:text-5xl leading-tight">
						{subheading}
					</h2>
					<a
						class="btn btn-accent md:btn-lg mt-3 md:mt-4 shadow-lg"
						href={event.signUp}
					>
						Sign Up! <span class="opacity-50">↵</span>
					</a>
				</div>
			</div>
		</div>
	</div>
</header>
