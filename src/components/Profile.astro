---
interface Social {
	name: string;
	href: string;
	icon: string;
}

interface Props {
	name: string;
	imgsrc: ImageMetadata;
	imgalt: string;
	class?: string;
	socials: Social[];
}

const { name, imgsrc, imgalt, class: classes, socials } = Astro.props;

import { Picture } from "astro:assets";
import { Icon } from "astro-icon/components";
---

<div class={`card md:card-side bg-base-300 ${classes}`}>
	<figure class="relative shrink-0 aspect-[4/3] md:aspect-auto md:w-56 lg:w-72">
		<Picture
			src={imgsrc}
			alt={imgalt}
			formats={["avif", "webp"]}
			fallbackFormat="jpeg"
			widths={[320, 586, 800, 1172]}
			loading="lazy"
			decoding="async"
			sizes="(min-width: 1024px) 288px, (min-width: 768px) 224px, 100vw"
			class="absolute inset-0 w-full h-full object-cover"
			pictureAttributes={{ class: "absolute inset-0 w-full h-full" }}
		/>
	</figure>
	<div class="card-body md:min-h-64">
		<h2 class="card-title">{name}</h2>
		<slot />
		<div class="text-2xl w-full mt-auto flex justify-end gap-2">
			{socials.map((social) => (
				<a
					data-encoded={btoa(social.href)}
					data-encoded-attr="href"
					href="loading"
				>
					<Icon name={social.icon} />
					<span class="sr-only" data-encoded={btoa(social.name)}>
						loading
					</span>
				</a>
			))}
		</div>
	</div>
</div>
