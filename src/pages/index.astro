---
import Banner from "../components/Banner.astro";
import Contact from "../components/Contact.astro";
import Event from "../components/Event.astro";
import Faq from "../components/Faq.astro";
import Main from "../components/Main.astro";
import Separator from "../components/Separator.astro";
import Sponsors from "../components/Sponsors.astro";
import Summary from "../components/Summary.astro";
import Team from "../components/Team.astro";
import Venue from "../components/Venue.astro";
import { event } from "../data/data.ts";
import Layout from "../layouts/Layout.astro";
---

<Layout
	description=`Hackberry is a ${event.hours} hour youth hackathon in Tauranga to make something cool, meet new people, learn something, and have fun.`
>
	<Banner heading={event.name} subheading="Tauranga's first youth hackathon!" />
	<Main>
		<Summary />
		<Separator />
		<Event />
		<Separator />
		<Team />
		<Separator />
		<Sponsors />
		<Separator />
		<Faq />
		<Separator />
		<Contact />
		<Separator />
	</Main>
</Layout>
